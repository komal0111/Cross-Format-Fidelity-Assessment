def plot_and_save_hist(data, title, outpath, bins=256):
    plt.figure(figsize=(6,4))
    plt.hist(data.flatten(), bins=bins)
    plt.title(title)
    plt.xlabel("Pixel value")
    plt.ylabel("Frequency")
    plt.tight_layout()
    plt.savefig(outpath)
    plt.close()

def plot_and_save_heatmap(arr, outpath, cmap="inferno"):
    plt.figure(figsize=(6,6))
    plt.imshow(arr, cmap=cmap)
    plt.title(Path(outpath).stem)
    plt.axis("off")
    plt.colorbar(fraction=0.03, pad=0.01)
    plt.tight_layout()
    plt.savefig(outpath)
    plt.close()


