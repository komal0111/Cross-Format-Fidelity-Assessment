def save_image_pil(arr, path, mode=None, quality=95):
    """Save numpy array as image using PIL/ImageIO. `arr` is HxW or HxWx3."""
    im = Image.fromarray(arr.astype(np.uint8))
    # Ensure parent exists
    Path(path).parent.mkdir(parents=True, exist_ok=True)
    ext = Path(path).suffix.lower()
    if ext in [".jpg", ".jpeg"]:
        im.save(path, quality=quality)
    else:
        im.save(path)

def compute_luminance(arr_rgb):
  
    R = arr_rgb[..., 0].astype(np.float32)
    G = arr_rgb[..., 1].astype(np.float32)
    B = arr_rgb[..., 2].astype(np.float32)
    a, b, c = LUMINANCE_COEFFS
    Y = (a * R + b * G + c * B)
    # Clip to 0-255
    Y = np.clip(np.rint(Y), 0, 255).astype(np.uint8)
    return Y

def read_dicom(dcm_path):
   
    ds = pydicom.dcmread(dcm_path, force=True)
    arr = ds.pixel_array
    # If modality or rescale present, apply rescale to get display values (optional)
    slope = float(getattr(ds, "RescaleSlope", 1.0))
    intercept = float(getattr(ds, "RescaleIntercept", 0.0))
    if slope != 1.0 or intercept != 0.0:
        arr = arr.astype(np.float32) * slope + intercept
        # If original was integer-like, map back to 0-255 if needed (we assume 8-bit)
        arr = np.clip(np.rint(arr), 0, 255).astype(np.uint8)
    return ds, arr


