    arr_rgb, ds = load_dicom_any(INP)

    if arr_rgb.ndim != 3 or arr_rgb.shape[2] != 3:
        raise ValueError("DICOM is not RGB!")

    # ---------------- RGB Channel analysis ----------------
    R = arr_rgb[...,0].astype(float)
    G = arr_rgb[...,1].astype(float)
    B = arr_rgb[...,2].astype(float)

    ch_stats = {
        "max_diff_RG": float(np.abs(R-G).max()),
        "max_diff_RB": float(np.abs(R-B).max()),
        "max_diff_GB": float(np.abs(G-B).max()),
        "mean_diff_RG": float(np.abs(R-G).mean()),
        "mean_diff_RB": float(np.abs(R-B).mean()),
        "mean_diff_GB": float(np.abs(G-B).mean()),
    }
   

