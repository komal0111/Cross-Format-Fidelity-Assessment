from skimage.metrics import structural_similarity as ssim, peak_signal_noise_ratio as psnr


def ensure_dir(p): Path(p).mkdir(parents=True, exist_ok=True)

def load_dicom_any(p1):
    
    ds = pydicom.dcmread(p1, force=True)
    arr = ds.pixel_array  
    arr = np.asarray(arr)

   
    if ds.PhotometricInterpretation in ["YBR_FULL", "YBR_FULL_422"]:
        arr = pydicom.pixel_data_handlers.util.convert_color_space(arr, 
                                                                   "YBR_FULL",
                                                                   "RGB")
 if arr.dtype = np.uint8:
        arr = np.clip(arr, 0, 255).astype(np.uint8)
    return arr, ds

def save_image(arr, p1, quality=95):
    Image.fromarray(arr.astype(np.uint8)).save(p1, quality=quality)

