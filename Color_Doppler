        out_path = out/f"rgb_export.{fmt}"
        save_image(arr_rgb, out_path)

        conv = np.array(Image.open(out_path)).astype(np.uint8)
        if conv.ndim == 2:
            conv = np.stack([conv]*3, axis=2)

        SS = ssim(arr_rgb, conv, data_range=255, channel_axis=2)
        PP = psnr(arr_rgb, conv, data_range=255)

        conv_gray = np.mean(conv, axis=2).astype(np.uint8)
        stats = pixel_stats(base_gray, conv_gray)
        histc = histogram_corr(base_gray, conv_gray)
        rows_rgb.append({**{"format":fmt, "SSIM":SS, "PSNR":PP, "histogram_correlation":histc}, **stats})

        plot_heatmap(stats["diff_map_uint8"], f"RGB vs {fmt}", out/f"diff_rgb_vs_{fmt}.png")

    pd.DataFrame(rows_rgb).to_csv(out/"rgb_to_formats.csv", index=False)

