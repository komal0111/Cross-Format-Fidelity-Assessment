def histogram_corr(a,b):
    ha,_ = np.histogram(a.flatten(), bins=256, range=(0,255))
    hb,_ = np.histogram(b.flatten(), bins=256, range=(0,255))
    if ha.std()==0 or hb.std()==0: return 0
    return float(np.corrcoef(ha,hb)[0,1])

