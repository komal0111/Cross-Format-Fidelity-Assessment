def pixel_stats(a,b):
    diff = np.abs(a.astype(int) - b.astype(int))
    return {
        "max_pixel_diff": int(diff.max()),
        "mean_pixel_diff": float(diff.mean()),
        "median_pixel_diff": float(np.median(diff)),
        "std_pixel_diff": float(diff.std()),
        "rmse": float(np.sqrt(np.mean(diff**2))),
        "percent_pixels_changed": 100*float(np.sum(diff>0))/diff.size,
        "percent_pixels_changed_gt5": 100*float(np.sum(diff>5))/diff.size,
        "diff_map_uint8": np.clip(diff,0,255).astype(np.uint8)
    }

def analyze_rgb_dicom():
    out = P1(OUT)
    ensure_dir(out)

